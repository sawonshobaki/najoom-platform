generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTIPLE_SELECT
  MATCHING
  ORDERING
  FILL_IN_BLANK
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum AssessmentType {
  QUIZ
  EXAM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

enum ErrorPatternStatus {
  ACTIVE
  RESOLVED
}

enum RemedialPlanTargetType {
  STUDENT
  GROUP
  SECTION
  GRADE
}

enum RemedialPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RemedialPlanStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum RemedialPlanOutcome {
  PENDING_REASSESSMENT
  IMPROVED
  NEEDS_FURTHER_SUPPORT
}

enum FlashcardDifficulty {
  EASY
  MEDIUM
  HARD
}

enum FlashcardSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum FlashcardStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum PointEventType {
  CONCEPT_MASTERY
  IMPROVEMENT
  ACTIVITY_COMPLETION
  PERSISTENCE
  REMEDIAL_PLAN_COMPLETION
  FLASHCARD_PROGRESS
  ACHIEVEMENT
  MANUAL_ADJUSTMENT
}

enum NotificationType {
  GENERAL
  ASSIGNMENT
  ASSESSMENT
  ACHIEVEMENT
  REMEDIAL_PLAN
  RESOURCE
  SYSTEM
}

enum ResourceType {
  VIDEO
  WEBSITE
  ARTICLE
  OTHER
}

enum ResourceSource {
  MANUAL
  AI_SUGGESTED
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum SchoolContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiProvider {
  GEMINI
}

enum AiFeature {
  QUESTION_GENERATION
  ASSESSMENT_GENERATION
  STUDENT_ANALYSIS
  CLASS_ANALYSIS
  REMEDIAL_PLAN
  FLASHCARDS
  RESOURCE_SUGGESTIONS
}

enum AiRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
  teacher Teacher?

  sessions Session[]

  questionsCreated  Question[] @relation("QuestionCreatedBy")
  questionsReviewed Question[] @relation("QuestionReviewedBy")

  assessmentsCreated Assessment[] @relation("AssessmentCreatedBy")

  assignmentsCreated Assignment[]      @relation("AssignmentCreatedBy")
  assignmentGrades   AssignmentGrade[] @relation("AssignmentGradedBy")

  remedialPlansCreated RemedialPlan[] @relation("RemedialPlanCreatedBy")

  flashcardsCreated  Flashcard[] @relation("FlashcardCreatedBy")
  flashcardsReviewed Flashcard[] @relation("FlashcardReviewedBy")

  pointEventsCreated PointEvent[] @relation("PointEventCreatedBy")

  notificationsCreated  Notification[]          @relation("NotificationCreatedBy")
  notificationRecipients NotificationRecipient[]

  resourcesCreated  Resource[] @relation("ResourceCreatedBy")
  resourcesApproved Resource[] @relation("ResourceApprovedBy")

  schoolContentCreated SchoolContent[] @relation("SchoolContentCreatedBy")

  auditLogs AuditLog[] @relation("AuditLogActor")

  aiRequests AiRequest[] @relation("AiRequestRequestedBy")

  systemSettingsUpdated SystemSetting[] @relation("SystemSettingUpdatedBy")

  @@map("users")
}

model Student {
  id               String   @id @default(cuid())
  userId           String   @unique
  studentCode      String   @unique
  fullName         String
  currentSectionId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSection Section? @relation("CurrentSection", fields: [currentSectionId], references: [id])

  assessmentAttempts    AssessmentAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  conceptMastery StudentConceptMastery[]
  errorPatterns  StudentErrorPattern[]

  individualRemedialPlans RemedialPlan[]        @relation("RemedialPlanTargetStudent")
  remedialPlanMemberships RemedialPlanStudent[]

  flashcardProgress StudentFlashcardProgress[]

  pointEvents PointEvent[]
  points      StudentPoints?
  badges      StudentBadge[]

  @@map("students")
}

model Teacher {
  id          String   @id @default(cuid())
  userId      String   @unique
  teacherCode String   @unique
  fullName    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@map("teachers")
}

model Grade {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int

  sections    Section[]
  semesters   Semester[]
  assessments Assessment[]
  assignments Assignment[]

  remedialPlans RemedialPlan[]
  resources     Resource[]

  @@map("grades")
}

model Section {
  id       String  @id @default(cuid())
  gradeId  String
  name     String
  isActive Boolean @default(true)

  grade    Grade     @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  students Student[] @relation("CurrentSection")

  assessments Assessment[]
  assignments Assignment[]

  remedialPlans RemedialPlan[]
  resources     Resource[]

  @@unique([gradeId, name])
  @@map("sections")
}

// ======================================================
// Curriculum
// ======================================================

model Semester {
  id           String @id @default(cuid())
  gradeId      String
  name         String
  academicYear String
  sortOrder    Int

  grade Grade  @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  units Unit[]

  @@unique([gradeId, academicYear, sortOrder])
  @@index([gradeId])
  @@map("semesters")
}

model Unit {
  id          String  @id @default(cuid())
  semesterId  String
  title       String
  description String?
  sortOrder   Int

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lessons  Lesson[]

  @@unique([semesterId, sortOrder])
  @@index([semesterId])
  @@map("units")
}

model Lesson {
  id          String  @id @default(cuid())
  unitId      String
  title       String
  description String?
  sortOrder   Int

  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  concepts           Concept[]
  learningObjectives LearningObjective[]
  questions          Question[]
  resources          Resource[]

  @@unique([unitId, sortOrder])
  @@index([unitId])
  @@map("lessons")
}

model Concept {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  description String?

  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questions Question[]

  studentMastery StudentConceptMastery[]
  errorPatterns  StudentErrorPattern[]
  remedialPlans  RemedialPlan[]
  flashcards     Flashcard[]
  resources      Resource[]

  @@index([lessonId])
  @@map("concepts")
}

model LearningObjective {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  description String?

  lesson    Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  skills    LearningObjectiveSkill[]
  questions Question[]

  @@index([lessonId])
  @@map("learning_objectives")
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  learningObjectives LearningObjectiveSkill[]

  @@map("skills")
}

model LearningObjectiveSkill {
  learningObjectiveId String
  skillId             String

  learningObjective LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([learningObjectiveId, skillId])
  @@index([skillId])
  @@map("learning_objective_skills")
}

// ======================================================
// Question Bank
// ======================================================

model Question {
  id         String             @id @default(cuid())
  text       String
  type       QuestionType
  difficulty QuestionDifficulty
  points     Int                @default(1)

  lessonId            String
  conceptId           String?
  learningObjectiveId String?

  source QuestionSource @default(MANUAL)
  status QuestionStatus @default(DRAFT)

  createdById  String
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson            Lesson             @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  concept           Concept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  learningObjective LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)

  createdBy  User  @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  options              QuestionOption[]
  matchingPairs        QuestionMatchingPair[]
  orderingItems        QuestionOrderingItem[]
  acceptedBlankAnswers QuestionBlankAnswer[]

  assessmentLinks AssessmentQuestion[]

  @@index([lessonId])
  @@index([conceptId])
  @@index([learningObjectiveId])
  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@index([source])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  sortOrder  Int
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_options")
}

model QuestionMatchingPair {
  id         String @id @default(cuid())
  questionId String
  leftText   String
  rightText  String
  sortOrder  Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_matching_pairs")
}

model QuestionOrderingItem {
  id           String @id @default(cuid())
  questionId   String
  text         String
  correctOrder Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, correctOrder])
  @@index([questionId])
  @@map("question_ordering_items")
}

model QuestionBlankAnswer {
  id         String @id @default(cuid())
  questionId String
  answer     String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, answer])
  @@index([questionId])
  @@map("question_blank_answers")
}

// ======================================================
// Assessments
// ======================================================

model Assessment {
  id     String           @id @default(cuid())
  title  String
  type   AssessmentType
  status AssessmentStatus @default(DRAFT)

  gradeId   String
  sectionId String?

  durationSeconds     Int
  startsAt            DateTime?
  endsAt              DateTime?
  showResultsAt       DateTime?
  allowBackNavigation Boolean  @default(false)
  maxAttempts         Int      @default(1)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy User     @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@index([startsAt])
  @@map("assessments")
}

model AssessmentQuestion {
  id             String @id @default(cuid())
  assessmentId   String
  questionId     String
  sortOrder      Int
  pointsOverride Int?

  questionSnapshot Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  answers AssessmentAnswer[]

  @@unique([assessmentId, questionId])
  @@unique([assessmentId, sortOrder])
  @@index([questionId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id           String @id @default(cuid())
  assessmentId String
  studentId    String

  startedAt   DateTime @default(now())
  submittedAt DateTime?

  score    Int?
  maxScore Int?
  status   AttemptStatus @default(IN_PROGRESS)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  answers AssessmentAnswer[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id                   String @id @default(cuid())
  attemptId            String
  assessmentQuestionId String

  answerPayload Json

  isCorrect     Boolean?
  awardedPoints Int?
  answeredAt    DateTime @default(now())

  attempt            AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, assessmentQuestionId])
  @@index([assessmentQuestionId])
  @@map("assessment_answers")
}

// ======================================================
// Assignments
// ======================================================

model Assignment {
  id     String @id @default(cuid())
  title  String
  prompt String

  gradeId   String
  sectionId String?

  maxScore Int
  dueAt    DateTime?

  status AssignmentStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy User     @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  submissions AssignmentSubmission[]

  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  studentId    String

  answerText  String
  submittedAt DateTime                   @default(now())
  status      AssignmentSubmissionStatus @default(SUBMITTED)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  grade AssignmentGrade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model AssignmentGrade {
  id           String @id @default(cuid())
  submissionId String @unique

  score    Int
  feedback String?

  gradedById String
  gradedAt   DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User                 @relation("AssignmentGradedBy", fields: [gradedById], references: [id], onDelete: Restrict)

  @@index([gradedById])
  @@map("assignment_grades")
}

// ======================================================
// Learning Analytics
// ======================================================

model StudentConceptMastery {
  id        String @id @default(cuid())
  studentId String
  conceptId String

  masteryScore Float @default(0)

  attemptsCount  Int @default(0)
  correctCount   Int @default(0)
  incorrectCount Int @default(0)

  lastAssessedAt DateTime?

  confidenceScore Float @default(0)

  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
  @@index([conceptId])
  @@index([masteryScore])
  @@map("student_concept_mastery")
}

model StudentErrorPattern {
  id        String @id @default(cuid())
  studentId String
  conceptId String

  patternKey String

  occurrences      Int @default(0)
  assessmentsCount Int @default(0)

  lastSeenAt DateTime?

  confidenceScore Float @default(0)

  status ErrorPatternStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId, patternKey])
  @@index([studentId, status])
  @@index([conceptId])
  @@index([confidenceScore])
  @@map("student_error_patterns")
}

// ======================================================
// Remedial Plans
// ======================================================

model RemedialPlan {
  id    String @id @default(cuid())
  title String

  targetType RemedialPlanTargetType

  targetStudentId String?
  sectionId       String?
  gradeId         String?

  targetConceptId String

  status RemedialPlanStatus @default(DRAFT)

  generatedByAi Boolean @default(false)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activatedAt DateTime?
  completedAt DateTime?

  reassessedAt DateTime?
  outcome      RemedialPlanOutcome @default(PENDING_REASSESSMENT)

  outcomeNotes String?

  targetStudent Student? @relation("RemedialPlanTargetStudent", fields: [targetStudentId], references: [id], onDelete: Restrict)
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  grade         Grade?   @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  targetConcept Concept @relation(fields: [targetConceptId], references: [id], onDelete: Restrict)
  createdBy     User    @relation("RemedialPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  students RemedialPlanStudent[]
  steps    RemedialPlanStep[]

  @@index([targetStudentId])
  @@index([sectionId])
  @@index([gradeId])
  @@index([targetConceptId])
  @@index([status])
  @@index([targetType])
  @@map("remedial_plans")
}

model RemedialPlanStudent {
  planId    String
  studentId String
  addedAt   DateTime @default(now())

  plan    RemedialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([planId, studentId])
  @@index([studentId])
  @@map("remedial_plan_students")
}

model RemedialPlanStep {
  id     String @id @default(cuid())
  planId String

  title        String
  description  String
  activityType String

  orderIndex Int

  status RemedialPlanStepStatus @default(PENDING)

  estimatedMinutes Int?
  completedAt      DateTime?

  plan RemedialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, orderIndex])
  @@index([planId, status])
  @@map("remedial_plan_steps")
}

// ======================================================
// Flashcards
// ======================================================

model Flashcard {
  id    String @id @default(cuid())
  front String
  back  String

  conceptId String

  difficulty FlashcardDifficulty @default(MEDIUM)
  source     FlashcardSource     @default(MANUAL)
  status     FlashcardStatus     @default(DRAFT)

  createdById  String
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  createdBy  User  @relation("FlashcardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("FlashcardReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  studentProgress StudentFlashcardProgress[]

  @@index([conceptId])
  @@index([difficulty])
  @@index([status])
  @@index([source])
  @@map("flashcards")
}

model StudentFlashcardProgress {
  id          String @id @default(cuid())
  studentId   String
  flashcardId String

  reviewCount    Int @default(0)
  correctCount   Int @default(0)
  incorrectCount Int @default(0)

  masteryScore Float @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([studentId, flashcardId])
  @@index([studentId, nextReviewAt])
  @@index([flashcardId])
  @@index([masteryScore])
  @@map("student_flashcard_progress")
}

// ======================================================
// Points, Badges & Leaderboard Foundation
// ======================================================

model PointEvent {
  id        String         @id @default(cuid())
  studentId String
  eventType PointEventType
  points    Int

  sourceType String?
  sourceId   String?

  metadata Json?

  createdById String?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PointEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([eventType])
  @@index([sourceType, sourceId])
  @@map("point_events")
}

model StudentPoints {
  studentId   String   @id
  totalPoints Int      @default(0)
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
  @@map("student_points")
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  iconKey     String

  criteriaJson Json

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentBadge[]

  @@index([isActive])
  @@map("badges")
}

model StudentBadge {
  id        String @id @default(cuid())
  studentId String
  badgeId   String

  awardedAt DateTime @default(now())
  source    String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([studentId, badgeId])
  @@index([badgeId])
  @@index([studentId, awardedAt])
  @@map("student_badges")
}

// ======================================================
// Notifications
// ======================================================

model Notification {
  id    String @id @default(cuid())
  title String
  body  String
  type  NotificationType @default(GENERAL)

  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  recipients NotificationRecipient[]

  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id             String @id @default(cuid())
  notificationId String
  userId         String

  readAt DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

// ======================================================
// Educational Resources
// ======================================================

model Resource {
  id    String @id @default(cuid())
  title String
  url   String

  resourceType ResourceType
  source       ResourceSource @default(MANUAL)
  status       ResourceStatus @default(DRAFT)

  gradeId   String
  sectionId String?
  lessonId  String?
  conceptId String?

  createdById  String
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grade   Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  createdBy  User  @relation("ResourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User? @relation("ResourceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([gradeId])
  @@index([sectionId])
  @@index([lessonId])
  @@index([conceptId])
  @@index([status])
  @@index([source])
  @@index([resourceType])
  @@map("resources")
}

// ======================================================
// School Content
// ======================================================

model SchoolContent {
  id          String @id @default(cuid())
  contentType String
  title       String
  body        String

  status SchoolContentStatus @default(DRAFT)

  createdById String

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("SchoolContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([contentType])
  @@index([status])
  @@index([publishedAt])
  @@map("school_content")
}

// ======================================================
// Audit Log
// ======================================================

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?

  action     String
  entityType String
  entityId   String

  beforeJson Json?
  afterJson  Json?
  metadata   Json?

  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ======================================================
// AI Request Logging
// ======================================================

model AiRequest {
  id String @id @default(cuid())

  provider AiProvider @default(GEMINI)
  feature  AiFeature
  status   AiRequestStatus @default(PENDING)

  modelName     String?
  promptVersion String?

  requestedById String?

  inputHash String?

  latencyMs Int?

  inputTokens  Int?
  outputTokens Int?

  errorCode String?

  metadata Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  requestedBy User? @relation("AiRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([feature, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([provider])
  @@map("ai_requests")
}

// ======================================================
// System Settings
// ======================================================

model SystemSetting {
  id          String @id @default(cuid())
  key         String @unique
  value       Json
  description String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("system_settings")
}

// ======================================================
// Authentication Sessions
// Stores only the hash of the raw session token.
// Supports multiple devices and explicit revocation.
// ======================================================

model Session {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime?

  revokedAt    DateTime?
  revokeReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

enum LoginThrottleScope {
  USERNAME
  NETWORK
  USERNAME_NETWORK
}

model LoginThrottle {
  id             String             @id @default(cuid())
  scope          LoginThrottleScope
  identifierHash String

  failureCount    Int      @default(0)
  windowStartedAt DateTime
  lastFailureAt   DateTime?
  blockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, identifierHash])
  @@index([blockedUntil])
  @@index([updatedAt])
  @@map("login_throttles")
}
