generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTIPLE_SELECT
  MATCHING
  ORDERING
  FILL_IN_BLANK
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ARCHIVED
}

enum AssessmentType {
  QUIZ
  EXAM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

enum ErrorPatternStatus {
  ACTIVE
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student        Student?
  sectionChanges StudentSectionHistory[] @relation("SectionChangedBy")

  questionsCreated  Question[] @relation("QuestionCreatedBy")
  questionsReviewed Question[] @relation("QuestionReviewedBy")

  assessmentsCreated Assessment[] @relation("AssessmentCreatedBy")

  assignmentsCreated Assignment[]      @relation("AssignmentCreatedBy")
  assignmentGrades   AssignmentGrade[] @relation("AssignmentGradedBy")

  @@map("users")
}

model Student {
  id               String   @id @default(cuid())
  userId           String   @unique
  studentCode      String   @unique
  fullName         String
  currentSectionId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSection Section?                @relation("CurrentSection", fields: [currentSectionId], references: [id])
  sectionHistory StudentSectionHistory[]

  assessmentAttempts    AssessmentAttempt[]
  assignmentSubmissions AssignmentSubmission[]

  conceptMastery StudentConceptMastery[]
  errorPatterns  StudentErrorPattern[]

  @@map("students")
}

model Grade {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int

  sections    Section[]
  semesters   Semester[]
  assessments Assessment[]
  assignments Assignment[]

  @@map("grades")
}

model Section {
  id       String  @id @default(cuid())
  gradeId  String
  name     String
  isActive Boolean @default(true)

  grade       Grade                   @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  students    Student[]               @relation("CurrentSection")
  historyFrom StudentSectionHistory[] @relation("FromSection")
  historyTo   StudentSectionHistory[] @relation("ToSection")

  assessments Assessment[]
  assignments Assignment[]

  @@unique([gradeId, name])
  @@map("sections")
}

model StudentSectionHistory {
  id            String   @id @default(cuid())
  studentId     String
  fromSectionId String?
  toSectionId   String
  effectiveAt   DateTime @default(now())
  note          String?
  changedById   String?

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSection Section? @relation("FromSection", fields: [fromSectionId], references: [id], onDelete: Restrict)
  toSection   Section  @relation("ToSection", fields: [toSectionId], references: [id], onDelete: Restrict)
  changedBy   User?    @relation("SectionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([studentId, effectiveAt])
  @@map("student_section_history")
}

// ======================================================
// Curriculum
// ======================================================

model Semester {
  id           String @id @default(cuid())
  gradeId      String
  name         String
  academicYear String
  sortOrder    Int

  grade Grade  @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  units Unit[]

  @@unique([gradeId, academicYear, sortOrder])
  @@index([gradeId])
  @@map("semesters")
}

model Unit {
  id          String  @id @default(cuid())
  semesterId  String
  title       String
  description String?
  sortOrder   Int

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  lessons  Lesson[]

  @@unique([semesterId, sortOrder])
  @@index([semesterId])
  @@map("units")
}

model Lesson {
  id          String  @id @default(cuid())
  unitId      String
  title       String
  description String?
  sortOrder   Int

  unit               Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  concepts           Concept[]
  learningObjectives LearningObjective[]
  questions          Question[]

  @@unique([unitId, sortOrder])
  @@index([unitId])
  @@map("lessons")
}

model Concept {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  description String?

  lesson    Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  questions Question[]

  studentMastery StudentConceptMastery[]
  errorPatterns  StudentErrorPattern[]

  @@index([lessonId])
  @@map("concepts")
}

model LearningObjective {
  id          String  @id @default(cuid())
  lessonId    String
  title       String
  description String?

  lesson    Lesson                   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  skills    LearningObjectiveSkill[]
  questions Question[]

  @@index([lessonId])
  @@map("learning_objectives")
}

model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  learningObjectives LearningObjectiveSkill[]

  @@map("skills")
}

model LearningObjectiveSkill {
  learningObjectiveId String
  skillId             String

  learningObjective LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([learningObjectiveId, skillId])
  @@index([skillId])
  @@map("learning_objective_skills")
}

// ======================================================
// Question Bank
// ======================================================

model Question {
  id                  String             @id @default(cuid())
  text                String
  type                QuestionType
  difficulty          QuestionDifficulty
  points              Int                @default(1)

  lessonId            String
  conceptId           String?
  learningObjectiveId String?

  source              QuestionSource @default(MANUAL)
  status              QuestionStatus @default(DRAFT)

  createdById  String
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson            Lesson             @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  concept           Concept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  learningObjective LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)

  createdBy  User  @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  options              QuestionOption[]
  matchingPairs        QuestionMatchingPair[]
  orderingItems        QuestionOrderingItem[]
  acceptedBlankAnswers QuestionBlankAnswer[]

  assessmentLinks AssessmentQuestion[]

  @@index([lessonId])
  @@index([conceptId])
  @@index([learningObjectiveId])
  @@index([type])
  @@index([difficulty])
  @@index([status])
  @@index([source])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  sortOrder  Int
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_options")
}

model QuestionMatchingPair {
  id         String @id @default(cuid())
  questionId String
  leftText   String
  rightText  String
  sortOrder  Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_matching_pairs")
}

model QuestionOrderingItem {
  id           String @id @default(cuid())
  questionId   String
  text         String
  correctOrder Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, correctOrder])
  @@index([questionId])
  @@map("question_ordering_items")
}

model QuestionBlankAnswer {
  id         String @id @default(cuid())
  questionId String
  answer     String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, answer])
  @@index([questionId])
  @@map("question_blank_answers")
}

// ======================================================
// Assessments
// ======================================================

model Assessment {
  id                  String           @id @default(cuid())
  title               String
  type                AssessmentType
  status              AssessmentStatus @default(DRAFT)

  gradeId   String
  sectionId String?

  durationSeconds     Int
  startsAt            DateTime?
  endsAt              DateTime?
  showResultsAt       DateTime?
  allowBackNavigation Boolean   @default(false)
  maxAttempts         Int       @default(1)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy User     @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@index([startsAt])
  @@map("assessments")
}

model AssessmentQuestion {
  id             String @id @default(cuid())
  assessmentId   String
  questionId     String
  sortOrder      Int
  pointsOverride Int?

  questionSnapshot Json?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  answers AssessmentAnswer[]

  @@unique([assessmentId, questionId])
  @@unique([assessmentId, sortOrder])
  @@index([questionId])
  @@map("assessment_questions")
}

model AssessmentAttempt {
  id           String        @id @default(cuid())
  assessmentId String
  studentId    String

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  score    Int?
  maxScore Int?
  status   AttemptStatus @default(IN_PROGRESS)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  answers AssessmentAnswer[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id                   String   @id @default(cuid())
  attemptId            String
  assessmentQuestionId String

  answerPayload Json

  isCorrect     Boolean?
  awardedPoints Int?
  answeredAt    DateTime @default(now())

  attempt            AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, assessmentQuestionId])
  @@index([assessmentQuestionId])
  @@map("assessment_answers")
}

// ======================================================
// Assignments
// Manual teacher grading only.
// ======================================================

model Assignment {
  id     String @id @default(cuid())
  title  String
  prompt String

  gradeId   String
  sectionId String?

  maxScore Int
  dueAt    DateTime?

  status AssignmentStatus @default(DRAFT)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade     Grade    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  createdBy User     @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  submissions AssignmentSubmission[]

  @@index([gradeId])
  @@index([sectionId])
  @@index([status])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String
  studentId    String

  answerText  String
  submittedAt DateTime                   @default(now())
  status      AssignmentSubmissionStatus @default(SUBMITTED)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  grade AssignmentGrade?

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("assignment_submissions")
}

model AssignmentGrade {
  id           String @id @default(cuid())
  submissionId String @unique

  score    Int
  feedback String?

  gradedById String
  gradedAt   DateTime @default(now())

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  gradedBy   User                 @relation("AssignmentGradedBy", fields: [gradedById], references: [id], onDelete: Restrict)

  @@index([gradedById])
  @@map("assignment_grades")
}

// ======================================================
// Learning Analytics
// Calculated by deterministic application logic.
// AI may interpret these records later, but it does not
// directly own or arbitrarily modify mastery calculations.
// ======================================================

model StudentConceptMastery {
  id        String @id @default(cuid())
  studentId String
  conceptId String

  // Stored on a 0–100 scale.
  masteryScore Float @default(0)

  attemptsCount  Int @default(0)
  correctCount   Int @default(0)
  incorrectCount Int @default(0)

  lastAssessedAt DateTime?

  // Confidence in the available evidence, also 0–100.
  confidenceScore Float @default(0)

  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId])
  @@index([conceptId])
  @@index([masteryScore])
  @@map("student_concept_mastery")
}

model StudentErrorPattern {
  id        String @id @default(cuid())
  studentId String
  conceptId String

  // Stable internal identifier for the detected error pattern.
  // Example: CONFUSES_LIVING_AND_NONLIVING
  patternKey String

  occurrences      Int @default(0)
  assessmentsCount Int @default(0)

  lastSeenAt DateTime?

  // Confidence that this is a recurring pattern, not a single error.
  confidenceScore Float @default(0)

  status ErrorPatternStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([studentId, conceptId, patternKey])
  @@index([studentId, status])
  @@index([conceptId])
  @@index([confidenceScore])
  @@map("student_error_patterns")
}